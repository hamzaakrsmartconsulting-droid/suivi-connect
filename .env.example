# Database
DATABASE_URL="postgresql://suivi:suivi_password@localhost:5433/suivi_medicale?schema=public"

# JWT
JWT_SECRET="changez-ce-secret-en-production"
JWT_REFRESH_SECRET="changez-ce-refresh-secret-en-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# SMTP (optionnel en dev - les tokens sont loggés en console)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@suivi-medicale.fr"
